# Google Workspace Configuration
WORKSPACE_DOMAIN=yourdomain.com
ADMIN_USER_EMAIL=admin@yourdomain.com

# Time range for log retrieval (in hours)
LOG_HOURS_BACK=24

# Output directory for logs
LOGS_OUTPUT_DIR=logs

# Output directory for analysis results
ANALYSIS_OUTPUT_DIR=analysis

# Threat Intelligence API Keys (all optional but recommended)
# Get your free API key from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# Get your API key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_key_here

# Get your free token from: https://ipinfo.io/signup
IPINFO_TOKEN=your_ipinfo_token_here

# Anthropic API Key for AI-powered tier-2 analysis
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Data Enrichment Settings (set to false to disable specific enrichments)
ENABLE_IP_REPUTATION=true
ENABLE_GEOLOCATION_ENRICHMENT=true
ENABLE_USER_CONTEXT_ENRICHMENT=true
ENABLE_HISTORICAL_BASELINE=true

# Historical Baseline Database
BASELINE_DB_PATH=analysis/baseline.json
BASELINE_LOOKBACK_DAYS=30
